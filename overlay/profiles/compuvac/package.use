# seatd runs as the seat arbiter (no elogind)
sys-auth/seatd server
# Wayland only: one program on screen through cage, no X server
x11-misc/ly -X
gui-wm/cage -X
# Kernel: initramfs via dracut; the live image adds dmsquash-live itself.
sys-kernel/installkernel dracut grub
gui-libs/wlroots -X
# The build and the installer run dracut themselves (it cannot run under ROOT=).
sys-kernel/gentoo-kernel-bin -initramfs
sys-kernel/gentoo-kernel -initramfs
sys-fs/squashfs-tools zstd xz
# Audio for the session (no systemd user services; the session starts PipeWire itself).
media-video/pipewire sound-server pipewire-alsa
# No elogind runs: without this WirePlumber can treat the seat as inactive and mute audio.
media-video/wireplumber -elogind
media-video/pipewire -elogind

# fastfetch: Lua scripting is not needed
app-misc/fastfetch -lua -X -xcb -xrandr -gnome -imagemagick -chafa -opencl
