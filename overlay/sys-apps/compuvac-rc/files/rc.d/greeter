#!/bin/sh
# Ly on tty1. init runs this from inittab and respawns it; it only execs.
# Ly needs a login-style environment, which init does not give.
exec /usr/bin/env -i PATH=/usr/bin HOME=/root USER=root LOGNAME=root \
	SHELL=/bin/bash TERM=linux LANG=en_GB.UTF-8 \
	/sbin/agetty --noclear --skip-login --nonewline --noissue \
	--login-program /usr/bin/ly 38400 tty1 linux
