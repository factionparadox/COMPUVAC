#!/bin/bash
# the login screen: Ly on tty1, restarted whenever it exits
. /etc/rc.d/functions
case "$1" in
  start) say "OPERATOR IDENTIFICATION" sh -c 'setsid sh -c "while :; do agetty --noclear --skip-login --nonewline --noissue --login-program /usr/bin/ly 38400 tty1 linux; sleep 1; done" </dev/null >/dev/null 2>&1 &' ;;
  stop)  say "OPERATOR IDENTIFICATION" sh -c 'pkill -f "login-program /usr/bin/ly"; pkill -x ly; true' ;;
esac
