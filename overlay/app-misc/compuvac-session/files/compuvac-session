#!/bin/sh
# Ly starts this. One program owns the screen: the terminal.
# No elogind here. Ly names the runtime directory but nothing creates it,
# so the session always makes sure it exists and is private.
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR
# Everything the session says goes to a log, so a failure can be read afterwards.
mkdir -p "$HOME/.local/state"
exec >"$HOME/.local/state/compuvac-session.log" 2>&1
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1   # no title bars: one program, whole screen
export MC_SKIN=compuvac
export COMPUVAC=1

if [ "${1:-}" != inside ]; then
	# A private session bus: PipeWire's session manager needs one.
	exec dbus-run-session -- "$0" inside
fi

# Sound (PipeWire, with no systemd user services to start it) and the
# function keys run alongside the screen and stop with it.
pipewire & sleep 0.5
wireplumber &
pipewire-pulse &
compuvac-keys &
compuvac-sound boot &
# On battery the screen keeps its look but holds still (no flicker, jitter,
# noise or burn-in), so it is only redrawn when something changes.
# On mains power, or on a machine with no battery, the full effects.
profile="Compuvac"
for ps in /sys/class/power_supply/*; do
	[ "$(cat "$ps/type" 2>/dev/null)" = Battery ] || continue
	profile="Compuvac Calm"
	for ac in /sys/class/power_supply/*; do
		case "$(cat "$ac/type" 2>/dev/null)" in Mains|USB) ;; *) continue ;; esac   # USB-C chargers report USB
		[ "$(cat "$ac/online" 2>/dev/null)" = 1 ] && profile="Compuvac"
	done
	break
done
# cool-retro-term only honours -e for the program, and -e must come last.
# It also never starts a program given with no arguments (an empty argument
# list breaks under Qt 6), so the console gets one it ignores.
cage -s -d -- cool-retro-term --fullscreen --profile "$profile" \
	-e /usr/bin/compuvac-console operator
kill $(jobs -p) 2>/dev/null
