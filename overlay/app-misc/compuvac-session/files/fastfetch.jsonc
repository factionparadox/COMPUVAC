// Compuvac's fastfetch: green, in its own words.
// The logo is /etc/compuvac/logo.txt (plain text; $1 marks the green colour).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/compuvac/logo.txt",
    "color": { "1": "green" },
    "padding": { "right": 2 }
  },
  "display": {
    "color": { "keys": "bright_green", "title": "bright_green", "output": "green" },
    "separator": "  "
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os",       "key": "SYSTEM    " },
    { "type": "kernel",   "key": "CORE      " },
    { "type": "uptime",   "key": "IN SERVICE" },
    { "type": "packages", "key": "PROGRAMS  " },
    { "type": "cpu",      "key": "PROCESSOR " },
    { "type": "gpu",      "key": "DISPLAY   " },
    { "type": "memory",   "key": "MEMORY    " },
    { "type": "disk",     "key": "CORE STORE", "folders": "/" },
    { "type": "battery",  "key": "POWER     " },
    { "type": "wifi",     "key": "LINK      " }
  ]
}
