#!/bin/bash
# comp-src — compile source: Compuvac's software requisition, speaking for Portage.
# Installed also as 'compuvac', for the machine itself (tune, rebuild, status).
# Either name runs any directive; each shows its own help.
set -o pipefail
G=$'\e[32m' B=$'\e[1;32m' D=$'\e[2;32m' N=$'\e[0m'
say()   { printf '%s%s%s\n' "$B" "$*" "$N"; }
note()  { printf '%s%s%s\n' "$D" "$*" "$N"; }
fault() { compuvac-sound fault; printf '%sFAULT: %s%s\n' "$B" "$*" "$N" >&2; exit 1; }
# Compuvac compiles its own software: no binary packages.
EMERGE=(emerge)
USEDIR=/etc/portage/package.use
ME=$(basename "$0")

need_root() {
	[ "$EUID" = 0 ] && return
	note "OPERATOR CLEARANCE REQUIRED."
	if command -v doas >/dev/null; then exec doas "$0" "$@"; fi
	exec su -c "$(printf '%q ' "$0" "$@")"
}

need_archive() {  # Gentoo's package tree isn't shipped; fetch it on first use.
	[ -f /var/db/repos/gentoo/metadata/timestamp.chk ] && return
	say "NO ARCHIVE HELD. FETCHING IT (ONE TIME)."
	emerge-webrsync -q || fault "ARCHIVE UNREACHABLE. JOIN A NETWORK FIRST (CTRL+SPACE, NETWORK)."
}

sync_compuvac() {  # Compuvac's own packages come from its GitHub repository.
	local t ref; t=$(mktemp -d) || return 1
	# Ask for the newest commit by its id: GitHub can serve a stale copy of 'main' for a few minutes.
	ref=$(wget -qO- https://api.github.com/repos/factionparadox/COMPUVAC/commits/main |
		sed -n 's/^  "sha": "\([0-9a-f]*\)",$/\1/p' | head -1)
	if wget -qO- "https://codeload.github.com/factionparadox/COMPUVAC/tar.gz/${ref:-refs/heads/main}" |
		tar -xz -C "$t" --strip-components=1 --wildcards '*/overlay' 2>/dev/null &&
		[ -f "$t/overlay/profiles/repo_name" ]; then
		rm -rf /var/db/repos/compuvac.old
		if mv /var/db/repos/compuvac /var/db/repos/compuvac.old &&
			mv "$t/overlay" /var/db/repos/compuvac; then
			rm -rf /var/db/repos/compuvac.old
			note "COMPUVAC'S OWN PACKAGES UPDATED (${ref:0:7})."
		else
			[ -d /var/db/repos/compuvac ] || mv /var/db/repos/compuvac.old /var/db/repos/compuvac
			note "COULD NOT REPLACE COMPUVAC'S PACKAGES; KEEPING THEM AS THEY ARE."
		fi
	else
		note "COULD NOT REACH COMPUVAC'S REPOSITORY; KEEPING ITS PACKAGES AS THEY ARE."
	fi
	rm -rf "$t"
}

confirm() { local a; read -rp "${G}$1 [y/N] ${N}" a </dev/tty; [[ ${a,,} == y* ]]; }

resolve() {  # name -> cat/pkg
	local atom
	atom=$(equery -q list -p -F '$category/$name' "$1" 2>/dev/null | sort -u)
	[ -z "$atom" ] && atom=$(equery -q list -p -F '$category/$name' "*/$1" 2>/dev/null | sort -u)
	case $(grep -c . <<<"$atom") in
		0) fault "NO RECORD OF '${1^^}' IN THE ARCHIVE." ;;
		1) echo "$atom" ;;
		*) say "'${1^^}' IS AMBIGUOUS. SPECIFY:" >&2; sed 's/^/   /' <<<"$atom" >&2; exit 1 ;;
	esac
}

interrogate() {  # ask about each USE flag of $1, write package.use
	local atom=$1 file="$USEDIR/compuvac-${1//\//_}" flags=() line flag def desc ans
	mapfile -t lines < <(equery -N -C uses "$atom" 2>/dev/null | grep -E '^ *[-+] [-+] ')
	if [ ${#lines[@]} -eq 0 ]; then note "NO OPTIONAL FUNCTIONS. PROCEEDING."; return; fi
	say "${atom^^}: ${#lines[@]} OPTIONAL FUNCTIONS."
	note "ANSWER Y OR N. RETURN ACCEPTS THE RECOMMENDATION SHOWN IN CAPITALS."
	echo
	for line in "${lines[@]}"; do
		def=$(awk '{print $2}' <<<"$line")
		flag=$(awk '{print $3}' <<<"$line")
		desc=$(sed 's/^[^:]*: *//' <<<"$line")
		[ "$def" = + ] && hint="Y/n" || hint="y/N"
		printf '%s%-22s%s %s\n' "$B" "${flag^^}" "$N" "${G}${desc}${N}"
		read -rp "${D}   ENABLE? [$hint] ${N}" ans </dev/tty
		case ${ans,,} in
			y*) flags+=("$flag") ;;
			n*) flags+=("-$flag") ;;
			*)  [ "$def" = + ] && flags+=("$flag") || flags+=("-$flag") ;;
		esac
	done
	mkdir -p "$USEDIR"
	printf '# Written by comp-src. Change with: comp-src reconsider %s\n%s %s\n' \
		"$atom" "$atom" "${flags[*]}" > "$file"
	echo; note "RECORDED IN ${file}."
}

case $1 in
install|requisition)
	shift; [ $# -ge 1 ] || fault "SPECIFY SOFTWARE."
	need_root install "$@"
	quick=; [ "$1" = -q ] && { quick=1; shift; }
	need_archive
	for name; do
		atom=$(resolve "$name") || exit 1
		say "REQUISITION: ${atom^^}"
		[ -z "$quick" ] && [ ! -f "$USEDIR/compuvac-${atom//\//_}" ] && interrogate "$atom"
		compuvac-sound launch
		"${EMERGE[@]}" --noreplace "$atom" || fault "REQUISITION OF ${atom^^} FAILED."
		say "${atom^^} IS HELD IN CORE STORE."
	done
	compuvac-sound return ;;
reconsider)
	shift; need_root reconsider "$@"
	need_archive
	atom=$(resolve "$1") || exit 1
	rm -f "$USEDIR/compuvac-${atom//\//_}"
	interrogate "$atom"
	"${EMERGE[@]}" --oneshot "$atom" || fault "REBUILD FAILED." ;;
remove|decommission)
	shift; need_root remove "$@"
	for name; do
		atom=$(resolve "$name") || exit 1
		say "DECOMMISSION: ${atom^^}"
		emerge --deselect "$atom" && emerge --depclean --ask=n "$atom" || fault "COULD NOT DECOMMISSION ${atom^^}."
		rm -f "$USEDIR/compuvac-${atom//\//_}"
	done
	say "DECOMMISSIONED." ;;
update)
	need_root update
	need_archive
	say "SYNCHRONISING ARCHIVE."
	emaint sync -a || fault "ARCHIVE UNREACHABLE."
	sync_compuvac
	say "BRINGING CORE STORE UP TO DATE."
	"${EMERGE[@]}" --update --deep --newuse @world || fault "UPDATE INCOMPLETE."
	emerge --depclean --ask=n
	say "CORE STORE CURRENT." ;;
tune)
	need_root tune
	mc=/etc/portage/make.conf
	j=$(nproc)
	ram=$(awk '/^MemTotal/ {print int($2/2097152)}' /proc/meminfo)   # one job per 2 GB of memory
	[ "${ram:-0}" -ge 1 ] && [ "$ram" -lt "$j" ] && j=$ram
	cpu=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)
	arch=$(gcc -march=native -Q --help=target 2>/dev/null | awk '$1=="-march=" {print $2; exit}')
	say "TUNING COMPUVAC FOR THIS MACHINE"
	note "   PROCESSOR   ${cpu^^}"
	note "   TARGET      -march=native (${arch:-unknown})   ${j} JOBS AT ONCE"
	sed -i "s|^COMMON_FLAGS=.*|COMMON_FLAGS=\"-O2 -pipe -march=native\"|; s|^MAKEOPTS=.*|MAKEOPTS=\"-j$j -l$j\"|" "$mc"
	grep -q '^MAKEOPTS=' "$mc" || echo "MAKEOPTS=\"-j$j -l$j\"" >> "$mc"
	mkdir -p /etc/portage/package.use
	cf=$(cpuid2cpuflags); case $cf in '*/*'*) ;; *) cf="*/* $cf" ;; esac   # newer versions add */* themselves
	echo "$cf" > /etc/portage/package.use/00cpu-flags
	note "   CPU_FLAGS   ${cf#*: }"
	# Graphics: build Mesa for the GPUs actually present. Without an AMD GPU,
	# Mesa needs no LLVM, which saves the longest compile after GCC.
	vc= amd=
	for v in /sys/class/drm/card[0-9]*/device/vendor; do
		case $(cat "$v" 2>/dev/null) in
			0x8086) vc="$vc intel" ;;
			0x1002) vc="$vc amdgpu radeonsi"; amd=1 ;;
			0x10de) vc="$vc nouveau" ;;
		esac
	done
	vc=$(tr ' ' '\n' <<<"$vc" | sort -u | grep . | tr '\n' ' ' | sed 's/ $//')
	if [ -n "$vc" ]; then
		sed -i '/^VIDEO_CARDS=/d' "$mc"; echo "VIDEO_CARDS=\"$vc\"" >> "$mc"
		note "   GRAPHICS    ${vc^^}"
		if [ -z "$amd" ]; then
			echo 'media-libs/mesa -llvm   # compuvac tune: no AMD GPU, so no LLVM' > /etc/portage/package.use/00compuvac-gpu
			note "               (NO AMD GPU: MESA WILL BE BUILT WITHOUT LLVM)"
		else
			rm -f /etc/portage/package.use/00compuvac-gpu
		fi
	fi
	say "SETTINGS WRITTEN TO $mc."
	note "EVERYTHING BUILT FROM NOW ON IS FOR THIS PROCESSOR."
	note "TO RECOMPILE WHAT IS ALREADY HERE: compuvac rebuild" ;;
rebuild)
	need_root rebuild
	need_archive
	sync_compuvac   # fixes to Compuvac's own packages arrive before compiling
	grep -q -- '-march=native' /etc/portage/make.conf ||
		note "NOTE: NOT TUNED FOR THIS MACHINE YET ('compuvac tune' FIRST IS RECOMMENDED)."
	state=/var/cache/compuvac; mkdir -p "$state"
	# When this rebuild began. An interrupted rebuild is continued: anything
	# compiled since then is not compiled again, even if settings have changed.
	since=
	[ -f "$state/rebuild-since" ] && since=$(cat "$state/rebuild-since")
	[ -z "$since" ] && [ -f "$state/rebuild-resume" ] && since=$(stat -c %Y "$state/rebuild-resume")  # earlier versions
	[ -n "$since" ] && say "CONTINUING THE REBUILD BEGUN $(date -d "@$since" '+%-d %B AT %H:%M' | tr a-z A-Z)."
	start=${since:-$(date +%s)}
	# A kernel installed as a binary is replaced by one compiled here.
	kswap=
	ls /var/db/pkg/sys-kernel 2>/dev/null | grep -q '^gentoo-kernel-bin-' && kswap=1
	nollvm=; [ -f /etc/portage/package.use/00compuvac-gpu ] && nollvm=1
	todo=()
	for d in /var/db/pkg/*/*; do
		pn=$(qatom -F '%{CATEGORY}/%{PN}' "${d#/var/db/pkg/}")
		bt=$(cat "$d/BUILD_TIME" 2>/dev/null || echo 0)
		[ "$bt" -lt "$start" ] || continue                       # already rebuilt
		case $pn in sys-kernel/gentoo-kernel-bin) continue ;; esac
		[ -n "$nollvm" ] && case $pn in llvm-core/*) continue ;; esac   # Mesa will not need it
		slot=$(cut -d/ -f1 "$d/SLOT" 2>/dev/null)
		todo+=("$pn${slot:+:$slot}")
	done
	say "REBUILD: ${#todo[@]} PROGRAMS TO COMPILE FROM SOURCE ON THIS MACHINE."
	[ -n "$kswap" ] && note "THE KERNEL WILL BE COMPILED HERE TOO, REPLACING THE PREBUILT ONE."
	[ -n "$nollvm" ] && note "LLVM IS SKIPPED: THIS MACHINE'S GRAPHICS DO NOT NEED IT."
	note "THIS TAKES MANY HOURS. THE MACHINE STAYS USABLE. MAINS POWER IS ADVISED."
	note "IF IT IS INTERRUPTED, RUN 'compuvac rebuild' AGAIN TO CONTINUE."
	confirm "PROCEED?" || fault "REBUILD ABANDONED."
	echo "$start" > "$state/rebuild-since"; rm -f "$state/rebuild-resume"
	compuvac-sound launch
	if [ -n "$kswap" ]; then
		emerge --deselect sys-kernel/gentoo-kernel-bin >/dev/null
		grep -qx sys-kernel/gentoo-kernel /var/lib/portage/world ||
			echo sys-kernel/gentoo-kernel >> /var/lib/portage/world
	fi
	if [ ${#todo[@]} -gt 0 ]; then
		emerge --oneshot --keep-going "${todo[@]}" ||
			fault "SOME PROGRAMS FAILED TO COMPILE (SEE ABOVE). RUN 'compuvac rebuild' TO RETRY."
	fi
	# Whatever the new settings call for that is not yet here (the source kernel,
	# Mesa without LLVM, and so on).
	emerge --update --deep --newuse --keep-going @world ||
		fault "SOME PROGRAMS FAILED TO COMPILE (SEE ABOVE). RUN 'compuvac rebuild' TO RETRY."
	rm -f "$state/rebuild-since"
	emerge --depclean --ask=n
	emerge @preserved-rebuild
	kver=$(ls -t /lib/modules | head -1)
	say "PREPARING THE NEW KERNEL ($kver)."
	dracut -q --force --hostonly --kver "$kver" "/boot/initramfs-$kver.img" &&
		grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || fault "BOOT FILES NOT UPDATED."
	compuvac-sound ready
	say "REBUILD COMPLETE. COMPUVAC IS NOW ENTIRELY ITS OWN WORK."
	note "RESTART TO USE THE NEW KERNEL." ;;
sync)
	need_root sync
	need_archive
	say "SYNCHRONISING ARCHIVE."
	emaint sync -a || fault "ARCHIVE UNREACHABLE."
	sync_compuvac
	say "ARCHIVE CURRENT AS OF $(cat /var/db/repos/gentoo/metadata/timestamp.chk)." ;;
owner|belongs)
	shift; [ $# -ge 1 ] || fault "SPECIFY A FILE."
	for f; do
		[ -e "$f" ] || command -v "$f" >/dev/null && f=$( [ -e "$f" ] && readlink -f "$f" || command -v "$f")
		o=$(qfile -qC "$f" 2>/dev/null | sort -u)
		[ -n "$o" ] && say "${f}: $(tr a-z A-Z <<<"$o" | tr '\n' ' ')" || say "${f}: NOT HELD BY ANY PROGRAM."
	done ;;
list)
	if [ "${2:-}" = all ]; then
		say "EVERY PROGRAM IN CORE STORE"
		qlist -ICv | sed 's/^/   /'
	else
		say "PROGRAMS YOU REQUISITIONED"
		sed 's/^/   /' /var/lib/portage/world
		note "(EVERYTHING, DEPENDENCIES INCLUDED: comp-src list all)"
	fi ;;
info|describe)
	shift; need_archive >/dev/null
	atom=$(resolve "$1") || exit 1
	best=$(portageq best_visible / ebuild "$atom")
	have=$(portageq best_version / "$atom")
	{ read -r desc; read -r home; } < <(portageq metadata / ebuild "$best" DESCRIPTION HOMEPAGE)
	say "${atom^^}"
	printf '%s   %s\n' "$G" "$desc"
	printf '   HOME        %s\n' "$home"
	printf '   AVAILABLE   %s\n' "${best#"$atom"-}"
	printf '   HELD        %s\n' "${have:+${have#"$atom"-}}${have:-NO}"
	f="$USEDIR/compuvac-${atom//\//_}"
	[ -f "$f" ] && printf '   FUNCTIONS   %s\n' "$(grep -v '^#' "$f" | cut -d' ' -f2-)"
	printf '%s' "$N" ;;
repos)
	say "ARCHIVES CONSULTED"
	eselect repository list -i 2>/dev/null | sed 1d | sed 's/^/   /'
	note "MORE: eselect repository list (ADD ONE WITH comp-src add-repo NAME)" ;;
add-repo)
	shift; need_root add-repo "$@"; [ $# -ge 1 ] || fault "SPECIFY AN ARCHIVE."
	need_archive
	for r; do
		say "ADDING ARCHIVE: ${r^^}"
		eselect repository enable "$r" >/dev/null && emaint sync -r "$r" || fault "COULD NOT ADD ${r^^}."
	done
	say "ARCHIVE ADDED. ITS SOFTWARE CAN NOW BE REQUISITIONED." ;;
drop-repo)
	shift; need_root drop-repo "$@"; [ $# -ge 1 ] || fault "SPECIFY AN ARCHIVE."
	for r; do
		[ "$r" = gentoo ] || [ "$r" = compuvac ] && fault "${r^^} CANNOT BE DROPPED: COMPUVAC DEPENDS ON IT."
		eselect repository remove -f "$r" >/dev/null || fault "COULD NOT DROP ${r^^}."
		say "ARCHIVE ${r^^} DROPPED."
	done ;;
clean)
	need_root clean
	say "REMOVING WHAT NOTHING NEEDS."
	emerge --depclean --ask=n
	say "DISCARDING OLD SOURCE ARCHIVES."
	eclean-dist --deep --quiet 2>/dev/null; true
	say "CORE STORE TIDY. $(df -h / | awk 'NR==2{print $4}') FREE." ;;
search)
	shift; [ $# -ge 1 ] || fault "SPECIFY SEARCH TERMS."
	say "SEARCHING ARCHIVE FOR: ${*^^}"
	emerge --search --searchdesc "$*" | grep -E '^\*|Description' |
		sed -E 's/^\*  /\n/; s/^ +Description: +/   /' ;;
status)
	say "COMPUVAC STATUS"
	printf '%s   PROGRAMS HELD   %s\n' "$G" "$(ls -d /var/db/pkg/*/* | wc -l)"
	printf '   CHOSEN          %s\n' "$(grep -c . /var/lib/portage/world)"
	printf '   ARCHIVE DATE    %s\n' "$(cat /var/db/repos/gentoo/metadata/timestamp.chk 2>/dev/null || echo UNKNOWN)"
	printf '   CORE STORE      %s free\n' "$(df -h / | awk 'NR==2{print $4}')"
	for b in /sys/class/power_supply/BAT*; do
		[ -r "$b/capacity" ] && printf '   BATTERY         %s%% %s\n' "$(cat "$b/capacity")" "$(tr a-z A-Z <"$b/status")"
	done
	p=$(powerprofilesctl get 2>/dev/null) && printf '   POWER PROFILE   %s\n' "${p^^}"
	printf '%s' "$N" ;;
""|help|-h|--help)
	if [ "$ME" = compuvac ]; then
	cat <<TXT
${B}COMPUVAC${N}
${G}  compuvac tune                fit the compiler settings to this machine's processor
  compuvac rebuild             recompile every program (and the kernel) from source here
  compuvac status              report on the core store

  Software is requisitioned with comp-src (try: comp-src help).${N}
TXT
	else
	cat <<TXT
${B}COMP-SRC · SOFTWARE REQUISITION${N}
${G}  comp-src install NAME...     compile and install (asks about each function)
  comp-src install -q NAME...  the same, taking the recommended functions
  comp-src reconsider NAME     answer the questions again and recompile
  comp-src remove NAME...      decommission software
  comp-src search WORDS        search the archive (names and descriptions)
  comp-src info NAME           what it is, versions, the functions you chose
  comp-src owner FILE          which program a file belongs to
  comp-src list [all]          what you requisitioned (all: everything held)

  comp-src sync                fetch the latest archive
  comp-src update              sync, then bring everything up to date
  comp-src clean               remove what nothing needs, old source archives

  comp-src repos               archives consulted
  comp-src add-repo NAME       consult another archive (e.g. guru)
  comp-src drop-repo NAME      stop consulting one

  The machine itself: compuvac tune, compuvac rebuild, compuvac status.${N}
TXT
	fi ;;
*) fault "UNKNOWN DIRECTIVE '${1^^}'. TRY: $ME help" ;;
esac
